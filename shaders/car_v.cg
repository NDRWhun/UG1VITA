// car effect: harmonic diffuse and specular lighting scaled by the view angle, reflection vector for the cube map.

float4 harmonic(float3 n, uniform float4 h[10])
{
    return h[0] + h[1] * (n.x * n.x) + h[2] * (n.y * n.y) + h[3] * (n.z * n.z) + h[4] * (n.x * n.y)
         + h[5] * (n.z * n.x) + h[6] * (n.y * n.z) + h[7] * n.x + h[8] * n.y + h[9] * n.z;
}

void main(
    float3 aPosition,
    float3 aNormal,
    float2 aTex0,
    uniform float4 uWvp[4],
    uniform float4 uWorldView[4],
    uniform float4 uLocalEyePos,
    uniform float4 uHarmonic[10],
    uniform float4 uDiffuseMin,
    uniform float4 uDiffuseRange,
    uniform float4 uSpecularMin,
    uniform float4 uSpecularRange,
    uniform float4 uPowers,
    float4 out vPosition : POSITION,
    float4 out vDiffuse : COLOR0,
    float4 out vSpecular : COLOR1,
    float2 out vTex0 : TEXCOORD0,
    float3 out vTex1 : TEXCOORD1)
{
    vPosition = aPosition.x * uWvp[0] + aPosition.y * uWvp[1] + aPosition.z * uWvp[2] + uWvp[3];
    vTex0 = aTex0;

    float3 view = uLocalEyePos.xyz - aPosition;
    view *= rsqrt(dot(view, view));
    float vdotn = max(0.01, dot(view, aNormal));
    float spec = pow(vdotn, uPowers.x);
    float env = pow(vdotn, uPowers.y);
    float4 diffuseScale = uDiffuseMin + vdotn * uDiffuseRange;
    float4 specularScale = uSpecularMin + spec * uSpecularRange;

    float4 d = harmonic(aNormal, uHarmonic) * diffuseScale;
    d.w = diffuseScale.w;
    vDiffuse = saturate(d * 0.5);

    float3 r = 2.0 * vdotn * aNormal - view;
    vTex1 = r.x * uWorldView[0].xyz + r.y * uWorldView[1].xyz + r.z * uWorldView[2].xyz;

    float4 s = harmonic(r, uHarmonic);
    float lum = pow(saturate(s.w), uPowers.x);
    vSpecular = saturate(float4(s.xyz * lum * specularScale.xyz * 0.5, env));
}
