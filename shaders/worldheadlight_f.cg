// worldheadlight effect: (headlight * depth fade * headlight colour + colour) * texture * 2.

#include "precision.h"

colour4 main(
    colour4 vColor : COLOR0,
    float2 vTex0 : TEXCOORD0,
    float3 vTex1 : TEXCOORD1,
    float2 vTex2 : TEXCOORD2,
    uniform sampler2D uTex0,
    uniform sampler2D uTex1,
    uniform sampler2D uTex2,
    uniform float4 uHeadlightColor,
    uniform float4 uAlphaTest) : COLOR
{
    colour4 t = tex2D<colour4>(uTex0, vTex0);
    colour4 h = tex2Dproj<colour4>(uTex1, vTex1);
    colour4 k = tex2D<colour4>(uTex2, vTex2);
    colour4 c;
    c.rgb = (h.rgb * k.rgb * (colour3)uHeadlightColor.rgb + vColor.rgb) * t.rgb * (colour)2.0;
    c.a = t.a * vColor.a * (colour)2.0;
#ifdef ATEST
    if (uAlphaTest.x * saturate(c.a) < uAlphaTest.y)
        discard;
#endif
    return c;
}
