// worldheadlightreflect effect: the headlight-lit texture * 2 plus the reflection; opaque.

#include "precision.h"

colour4 main(
    colour4 vColor : COLOR0,
    float2 vTex0 : TEXCOORD0,
    float3 vTex1 : TEXCOORD1,
    float3 vTex2 : TEXCOORD2,
    float2 vTex3 : TEXCOORD3,
    uniform sampler2D uTex0,
    uniform sampler2D uTex1,
    uniform sampler2D uTex2,
    uniform sampler2D uTex3,
    uniform float4 uHeadlightColor,
    uniform float4 uAlphaTest) : COLOR
{
    colour4 t = tex2D<colour4>(uTex0, vTex0);
    colour4 h = tex2Dproj<colour4>(uTex1, vTex1);
    colour4 k = tex2D<colour4>(uTex2, vTex3);
    colour4 r = tex2Dproj<colour4>(uTex3, vTex2);
    colour3 diffuse = (h.rgb * k.rgb * (colour3)uHeadlightColor.rgb + vColor.rgb) * t.rgb;
    colour4 c = colour4(diffuse * (colour)2.0 + t.a * vColor.a * r.rgb, 1.0);
#ifdef ATEST
    if (uAlphaTest.x < uAlphaTest.y)
        discard;
#endif
    return c;
}
