// filter effect: weighted sum of TAPS (1..4) texture samples. FACTOR 1..4: the blend factor outputs
// (render::FactorOutput): uBlendFactor, alpha = uBlendFactor.a, saturated colour * uBlendFactor,
// the speed blur mask (TAPS 1): alpha = s * smoothstep of m, with m = saturate((length(vTex1) - vTex2.x) * vTex2.y)
// and s = saturate((uBlendFactor.a - vTex3.x) * vTex3.y).

#include "precision.h"

colour4 main(
    float2 vTex0 : TEXCOORD0,
    float2 vTex1 : TEXCOORD1,
    float2 vTex2 : TEXCOORD2,
    float2 vTex3 : TEXCOORD3,
    uniform sampler2D uTex0,
    uniform sampler2D uTex1,
    uniform sampler2D uTex2,
    uniform sampler2D uTex3,
    uniform float4 uWeights[4],
    uniform float4 uAlphaTest,
    uniform float4 uBlendFactor) : COLOR
{
#if FACTOR == 1
    return uBlendFactor;
#else
    colour4 c = tex2D<colour4>(uTex0, vTex0) * (colour4)uWeights[0];
#if TAPS > 1
    c += tex2D<colour4>(uTex1, vTex1) * (colour4)uWeights[1];
#endif
#if TAPS > 2
    c += tex2D<colour4>(uTex2, vTex2) * (colour4)uWeights[2];
#endif
#if TAPS > 3
    c += tex2D<colour4>(uTex3, vTex3) * (colour4)uWeights[3];
#endif
#ifdef ATEST
    if (uAlphaTest.x * saturate(c.a) < uAlphaTest.y)
        discard;
#endif
#if FACTOR == 2
    return colour4(c.rgb, uBlendFactor.a);
#elif FACTOR == 3
    return saturate(c) * (colour4)uBlendFactor;
#elif FACTOR == 4
    float m = saturate((length(vTex1) - vTex2.x) * vTex2.y);
    float s = saturate((uBlendFactor.a - vTex3.x) * vTex3.y);
    return colour4(c.rgb, s * m * m * (3.0 - 2.0 * m));
#else
    return c;
#endif
#endif
}
