// world and worldbone effects: texture * colour * 2. PROJ divides the texture coordinates by w first.

float4 main(
    float4 vColor : COLOR0,
#ifdef PROJ
    float4 vTex0 : TEXCOORD0,
#else
    float2 vTex0 : TEXCOORD0,
#endif
    uniform sampler2D uTex0,
    uniform float4 uAlphaTest) : COLOR
{
#ifdef PROJ
    float4 c = tex2Dproj(uTex0, vTex0.xyw) * vColor * 2.0;
#else
    float4 c = tex2D(uTex0, vTex0) * vColor * 2.0;
#endif
#ifdef ATEST
    if (uAlphaTest.x * saturate(c.a) < uAlphaTest.y)
        discard;
#endif
    return c;
}
