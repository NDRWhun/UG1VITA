// world and worldbone effects: texture * colour * 2. PROJ divides the texture coordinates by w first.

#include "precision.h"

colour4 main(
    colour4 vColor : COLOR0,
#ifdef PROJ
    float4 vTex0 : TEXCOORD0,
#else
    float2 vTex0 : TEXCOORD0,
#endif
    uniform sampler2D uTex0,
    uniform float4 uAlphaTest) : COLOR
{
#ifdef PROJ
    colour4 c = tex2Dproj<colour4>(uTex0, vTex0.xyw) * vColor * (colour)2.0;
#else
    colour4 c = tex2D<colour4>(uTex0, vTex0) * vColor * (colour)2.0;
#endif
#ifdef ATEST
    if (uAlphaTest.x * saturate(c.a) < uAlphaTest.y)
        discard;
#endif
    return c;
}
